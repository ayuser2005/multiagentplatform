# ==============================================================================
# Nexora AI - Frontend environment template
#
# Vite inlines `VITE_*` variables at BUILD time.
#   cp .env.example .env
# ==============================================================================

# Leave empty to use same-origin relative URLs (`/api/...`).
# In Docker the Nginx container proxies `/api/*` to the API Gateway, so an
# empty value is correct there. Set this only when the API lives on another host.
VITE_SERVER_URL=

# Dev-only: target used by the Vite dev server proxy (see vite.config.js).
VITE_DEV_API_TARGET=http://localhost:8000

# ------------------------------------------------------------------------------
# Firebase Web SDK (public client configuration)
# Find these in Firebase Console -> Project settings -> Your apps -> Web app
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# Razorpay (optional)
# The backend returns the key id with the order; this is only a fallback.
# ------------------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=
