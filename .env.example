# ==============================================================================
# Nexora AI - Backend environment template
#
# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
#
# NEVER commit a real `.env` file. It is already listed in .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core
# ------------------------------------------------------------------------------
NODE_ENV=production

# Public URL of the deployed frontend. Used for CORS allow-listing.
# Supports a comma-separated list of allowed origins.
FRONTEND_URL=http://localhost

# Shared secret for service-to-service calls (agent -> auth, billing -> auth).
# Generate with: openssl rand -hex 32
# Leave empty to disable the check (the API Gateway still blocks external access).
INTERNAL_SERVICE_SECRET=

# Session cookie flags.
# COOKIE_SECURE=true once the site is served over HTTPS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------------------------
# Database (MongoDB Atlas or self-hosted MongoDB)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexora?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Cache / Sessions (Redis)
# ------------------------------------------------------------------------------
# Inside Docker Compose this is already set for you: redis://redis:6379
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# Firebase Authentication (Admin SDK)
# ------------------------------------------------------------------------------
# Provide EITHER a path to the service account JSON file...
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json

# ...OR the raw JSON inline (useful for CI / GitHub Actions secrets).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ...OR rely on Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# ------------------------------------------------------------------------------
# AI Providers
# ------------------------------------------------------------------------------
# Groq - fast LLM inference (used for chat, routing, coding, documents)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini - embeddings + vision + failover model
GOOGLE_API_KEY=AIza_your_google_api_key_here
# Optional alias, used as a fallback by the agent service
GEMINI_API_KEY=

# Tavily - real-time web search
TAVILY_API_KEY=tvly_your_tavily_api_key_here

# ------------------------------------------------------------------------------
# Vector Database (Qdrant) - used by the PDF/RAG agent
# ------------------------------------------------------------------------------
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# ------------------------------------------------------------------------------
# AWS S3 - artifact + image storage (optional; local disk is used as fallback)
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA_your_access_key_id
AWS_SECRET_KEY=your_secret_access_key
AWS_BUCKET_NAME=your-s3-bucket-name

# ------------------------------------------------------------------------------
# Payments (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ------------------------------------------------------------------------------
# Observability (LangSmith - optional)
# ------------------------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=nexora-platform

# ------------------------------------------------------------------------------
# Agent tuning (optional - sensible defaults are built in)
# ------------------------------------------------------------------------------
# IMAGE_MODEL_CHAIN=flux,default,turbo
# IMAGE_GEN_TIMEOUT_MS=20000
# BLOCK_REAL_PERSON_GENERATION=true
# IMAGE_PROMPT_ENHANCER=on
# IMAGE_AUTO_ASPECT=true
# INTERNAL_CALL_TIMEOUT_MS=15000
# MAX_PROMPT_LENGTH=20000
